body {
  font-family: Arial, Helvetica, sans-serif;
}
.menu {
  display: flex;
  background-color: rgb(230, 142, 27);
  padding: 10px;
  position: sticky;
  top: 0;
}
.menu1 {
  text-align: center;
  align-content: center;
  width: 100%;
  margin: 10px 30px;
}
.menu1 a {
  position: relative;
  text-decoration: none;
  color: #ffffffff;
  font-weight: bold;
  padding: 10px;
}
.menu1 a::after {
  content: "";
  left: 0;
  bottom: -2px;
  width: 100%;
  height: 3px;
  position: absolute;
  background: #ffffffff;
  border-radius: 5px;
  transform: translateY(10px);
  opacity: 0;
}
.menu1 a:hover::after {
  opacity: 1;
  transform: translateY(0);
}
